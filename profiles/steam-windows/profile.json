{
  "id": "steam-windows",
  "name": "Steam (Windows)",
  "workingDirectory": "Steam/prefix/drive_c/Program Files (x86)/Steam",
  "runtime": "Steam/Wine",
  "executable": "lib/wine/aarch64-unix/wine",
  "arguments": [
    "steam.exe",
    "-no-cef-sandbox",
    "-cef-disable-gpu",
    "-cef-disable-gpu-compositing",
    "-cef-disable-site-isolation"
  ],
  "libraries": [
    "lib/wine/aarch64-unix/ntdll.so",
    "lib/wine/aarch64-unix/win32u.so",
    "lib/wine/aarch64-unix/winemac.so",
    "lib/wine/aarch64-unix/winecoreaudio.so",
    "lib/wine/aarch64-unix/ws2_32.so",
    "lib/wine/aarch64-unix/opengl32.so",
    "lib/wine/aarch64-unix/winevulkan.so",
    "lib/wine/aarch64-unix/bcrypt.so",
    "lib/wine/aarch64-unix/crypt32.so",
    "lib/wine/aarch64-unix/secur32.so",
    "lib/wine/aarch64-unix/kerberos.so",
    "lib/wine/aarch64-unix/msv1_0.so",
    "lib/wine/aarch64-unix/netapi32.so",
    "lib/wine/aarch64-unix/dnsapi.so",
    "lib/wine/aarch64-unix/nsiproxy.so",
    "lib/wine/aarch64-unix/mountmgr.so",
    "lib/wine/aarch64-unix/dwrite.so",
    "lib/wine/aarch64-unix/winspool.so",
    "lib/wine/aarch64-unix/localspl.so",
    "lib/wine/aarch64-unix/wineps.so",
    "bin/wineserver.so",
    "lib/libfreetype.6.dylib",
    "lib/libgnutls.30.dylib"
  ],
  "codePool": 1400,
  "processes": 8,
  "environment": {
    "WINEPREFIX": "${Documents}/Steam/prefix",
    "WINESINGLEPROCESS": "2",
    "WINEJITPOOL": "${CodePool}",
    "FEX_MAXCODEBUFFERSIZE": "16",
    "FEX_DISABLEL2CACHE": "1",
    "WINE_VIRTUAL_RESERVE_MB": "4096",
    "WINEDLLOVERRIDES": "mscoree,mshtml=",
    "WINEDEBUG": "err+all,err-appbar,fixme-all,warn+process,warn+jitpool,+loaddll",
    "WINEAPPENDARGS": "steamwebhelper.exe=--single-process --in-process-gpu --js-flags=--jitless --disable-features=WinRetrieveSuggestionsOnlyOnDemand,DcheckIsFatal,BlockPromptsIfIgnoredOften,WebUsbDeviceDetection,ValveFFmpegAllowLowDelayHEVC,PartitionAllocBackupRefPtr;VampireSurvivors.exe=-systemallocator -job-worker-count 2 -logFile C:\\vs-systemalloc.log",
    "WINENOSPAWN": "steamsysinfo.exe;gldriverquery.exe;gldriverquery64.exe;vulkandriverquery.exe;vulkandriverquery64.exe;steamerrorreporter.exe;steamerrorreporter64.exe;winedbg.exe;winedbg;hardwareupdater.exe;winemenubuilder.exe;UnityCrashHandler64.exe",
    "TOLKARA_PROCESS_POOL": "steamwebhelper.exe=400;steam.exe=200;SteamService.exe=50;VampireSurvivors.exe=300;PenguinHotel=300;*=50",
    "TOLKARA_PROCESS_ENV": "steamwebhelper.exe>WINELARGERESERVE=0x7400000000-0x7e00000000 WINERELOCATEHINTS=1 WINEPACKHINTS=1 WINESOFTWAREPOOLS=2 WINESMALLRANGE=7c00000000-7e00000000 FEX_INITIALCODEBUFFERSIZE=128 FEX_MAXCODEBUFFERSIZE=128;steam.exe>FEX_INITIALCODEBUFFERSIZE=32 FEX_MAXCODEBUFFERSIZE=32;VampireSurvivors.exe>WINELARGERESERVE=0x7000000000-0x7100000000 WINESMALLRANGE=7000000000-7100000000 TOLKARA_PROCESS_RANGE_POOL=0x7000000000-0x7400000000 WINENOVULKAN=0 WINEDLLOVERRIDES=d3d11,d3d10core=n,b WINE_D3D_CONFIG=renderer=vulkan FEX_INITIALCODEBUFFERSIZE=64 FEX_MAXCODEBUFFERSIZE=64;PenguinHotel>WINELARGERESERVE=0x7000000000-0x7100000000 WINESMALLRANGE=7000000000-7100000000 TOLKARA_PROCESS_RANGE_POOL=0x7000000000-0x7400000000 WINENOVULKAN=0 WINEDLLOVERRIDES=d3d11,d3d10core=n,b WINE_D3D_CONFIG=renderer=vulkan FEX_INITIALCODEBUFFERSIZE=64 FEX_MAXCODEBUFFERSIZE=64;*> WINELARGERESERVE=0x7000000000-0x7100000000 WINESMALLRANGE=7000000000-7100000000 TOLKARA_PROCESS_RANGE_POOL=0x7000000000-0x7400000000 FEX_INITIALCODEBUFFERSIZE=16 FEX_MAXCODEBUFFERSIZE=16",
    "WINEAPPENDENV": "steamwebhelper.exe=FEX_INITIALCODEBUFFERSIZE=128 FEX_MAXCODEBUFFERSIZE=128",
    "TOLKARA_CHDIR": "${Documents}/Steam/prefix/drive_c/Program Files (x86)/Steam",
    "WINEDLLDIR": "${Documents}/Steam/Wine/lib/wine",
    "WINEDATADIR": "${Documents}/Steam/Wine/share/wine",
    "TOLKARA_LARGE_RESERVE_MB": "57344",
    "FEX_MAXINST": "5000",
    "FEX_MULTIBLOCK": "1",
    "TOLKARA_VM_MAP": "1",
    "WINEMAINSTACKSIZE": "64",
    "WINEJITPOOLNOREUSE": "1",
    "WINEEXCEPTIONMETADATA": "1",
    "TOLKARA_SOFTWARE_VM_MB": "512",
    "TOLKARA_STEAM_SOFTWARE_VM": "1",
    "TOLKARA_GUEST_WINDOW_COVERS_LAUNCHER": "1",
    "TOLKARA_FRONTMOST_GUEST_INPUT": "1",
    "WINEBUILTINCODEALIAS": "1",
    "WINENOVULKAN": "1",
    "WINEWAITDUMP": "${Documents}/Steam/wait-dump.request",
    "TOLKARA_PROCESS_RECLAIM_RANGES": "1",
    "TOLKARA_HOST_MEMORY_DIAGNOSTICS": "1",
    "TOLKARA_SESSION_AUDIO_ONLY": "1",
    "TOLKARA_SEPARATE_CODE_POOL": "1",
    "TOLKARA_REQUIRE_LOW_ARENA": "1"
  },
  "notes": "Eight-slot diagnostic: separate helper ranges and Meccha graphics; device validation pending."
}
