# Copy to local.env (ignored by git) and fill in your own values. The shell
# tools source it with bash: quote values that contain spaces or parentheses.
# A setting given on the command line (VAR=value tools/...) wins over this file.

# Your Apple Developer team ID (10 characters). Xcode > Settings > Accounts, or
# developer.apple.com > Membership. Not needed for simulator builds.
DEVELOPMENT_TEAM=

# Must be unique to you: Apple registers each bundle ID to one team only.
TOLKARA_BUNDLE_ID=local.tolkara.yourname

# Optional. Changing it later requires enrolling local authorization again.
#TOLKARA_KEYCHAIN_GROUP=local.tolkara.authorization

# Optional: iPad UDID or name (default: first connected device), and the
# simulator to use for simulator runs.
#DEVICE=
#SIMULATOR="iPad Pro 13-inch (M5)"

# Optional: the macOS executable you own. Several apps: separate them with ':'
# (like PATH); the compatibility libraries then cover all of them.
#GUEST_EXE="/Applications/Example.app/Contents/MacOS/Example"
# Optional: build for no particular application (NATIVE_GUEST_SHIMS=GENERIC to
# tools/install.sh, tools/run.sh sim): one adapter per translation/<Framework>/,
# GUEST_EXE not required. The application is chosen on the device.
#NATIVE_GUEST_SHIMS=
# Optional: your own profile outside profiles/ (those are always included).
# Several: separate them with ':'.
#TOLKARA_PROFILE=/path/to/profile.json
# Optional, experimental: adapters marked translation/<Leaf>/experimental take
# part in a build only when named here (separated by ':'), for example
# GameController:MetalFX. They work around one application's problems and
# change behaviour for every application in the build; none is on by default.
#TOLKARA_EXPERIMENTAL_ADAPTERS=

# Optional: preselect the execution mode for your builds: developer-service or
# local-signing (README, "Three ways to run code"). Without it the app asks on
# first launch.
# External JIT is not set here: tools/package_ipa.sh preselects it for its own build.
#TOLKARA_MODE=
# Local signing, optional: a capture of the application's final executable
# pages, for applications that rewrite their own code at launch. Tolkara cannot
# produce one yet. With several GUEST_EXE entries, give one entry per
# executable, separated by ':' in the same order: empty uses the on-disk code,
# "skip" builds no container for that executable.
#TOLKARA_CAPTURE=
# Local signing, optional: the identity that signs the page container (common
# name, part of it, or SHA-1), limited to DEVELOPMENT_TEAM. Default: "Apple Development".
#SIGN_IDENTITY=
