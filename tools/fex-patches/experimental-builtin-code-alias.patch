+  uint64_t ResolveCodeAddress(uint64_t Address) override {
+    if (ImageTracker->LookupExecutableFileSection(Address)) return Address;
+    ULONG_PTR Alias = Address;
+    // Wine-private query: builtin mapping metadata only, no byte scanning.
+    constexpr auto MemoryWineCodeAlias = static_cast<MEMORY_INFORMATION_CLASS>(2002);
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Address),
+                             MemoryWineCodeAlias, &Alias, sizeof(Alias), nullptr)) return Address;
+    return Alias;
+  }
+
   void PreCompile() override {
     ProcessPendingCrossProcessEmulatorWork();
