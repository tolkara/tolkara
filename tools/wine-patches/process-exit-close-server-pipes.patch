--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1578,9 +1578,23 @@
  *
  * Close server socket and exit process normally.
  */
+void server_disconnect_process(void)
+{
+    /* Tolkara may implement process exit as pthread_exit while other Wine
+     * instances remain alive. Do not rely on host process teardown to close
+     * this final thread's server pipes: its request pipe keeps the Windows
+     * process alive in wineserver even after fd_socket is closed. Match the
+     * normal pthread_exit_wrapper cleanup, touching only this thread's fds. */
+    close( ntdll_get_thread_data()->wait_fd[0] );
+    close( ntdll_get_thread_data()->wait_fd[1] );
+    close( ntdll_get_thread_data()->reply_fd );
+    close( ntdll_get_thread_data()->request_fd );
+    close( fd_socket );
+}
+
 void process_exit_wrapper( int status )
 {
-    close( fd_socket );
+    server_disconnect_process();
     exit( status );
 }
 
--- a/dlls/ntdll/unix/thread.c
