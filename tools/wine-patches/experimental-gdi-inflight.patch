--- a/dlls/win32u/dc.c
+++ b/dlls/win32u/dc.c
@@ -701,7 +701,7 @@
 /***********************************************************************
  *           NtGdiOpenDCW    (win32u.@)
  */
-HDC WINAPI NtGdiOpenDCW( UNICODE_STRING *device, const DEVMODEW *devmode, UNICODE_STRING *output,
+static HDC NtGdiOpenDCW_impl( UNICODE_STRING *device, const DEVMODEW *devmode, UNICODE_STRING *output,
                          ULONG type, BOOL is_display, HANDLE hspool, DRIVER_INFO_2W *driver_info,
                          void *pdev )
 {
@@ -1516,3 +1516,16 @@
     release_dc_ptr(dc);
     return ret;
 }
+
+/* Bounded runtime entry/exit counts; no caller or application memory inspection. */
+HDC WINAPI NtGdiOpenDCW( UNICODE_STRING *device, const DEVMODEW *devmode, UNICODE_STRING *output, ULONG type, BOOL is_display, HANDLE hspool, DRIVER_INFO_2W *driver_info, void *pdev )
+{
+    static LONG inflight, reported;
+    LONG count = InterlockedIncrement( &inflight );
+    HDC result;
+    if (count >= 16 && !(count & (count - 1)) && InterlockedIncrement( &reported ) <= 16)
+        ERR( "GDI inflight NtGdiOpenDCW %d\n", count );
+    result = NtGdiOpenDCW_impl( device, devmode, output, type, is_display, hspool, driver_info, pdev );
+    InterlockedDecrement( &inflight );
+    return result;
+}
