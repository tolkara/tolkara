  * Map a reservation the host cannot place at *base at an address congruent
  * to it modulo the largest power of two not above its size (WINERELOCATEHINTS).
  */
+static NTSTATUS map_software_pool( void **base, size_t size, int unix_prot )
+{
+    if (software_reserve_aligned && size >= ((size_t)1 << 30) &&
+        !(unix_prot & ~(PROT_READ | PROT_WRITE)))
+    {
+        size_t pool = size - 0x10000;
+        if (pool && !(pool & (pool - 1)) && ((ULONG_PTR)*base & (pool - 1)) == pool - 0x10000)
+        {
+            void *software = software_reserve_aligned( size, pool, pool - 0x10000, unix_prot );
+            if (software != MAP_FAILED)
+            {
+                *base = software;
+                ERR( "guarded pool reserved with software backing at %p size %zx\n", software, size );
+                return STATUS_SUCCESS;
+            }
+        }
+    }
+    return STATUS_NO_MEMORY;
+}
