@@ -1946,7 +1946,16 @@
 
     return start;
 }
+
 
+/* A failing allocation is often retried in a loop: log the first few failures
+ * of a kind and then one in 4096, so a retry loop cannot fill the device's
+ * storage with the same report (a Steam run once wrote 20 GB). */
+static BOOL failure_worth_logging( LONG *failures )
+{
+    LONG count = InterlockedIncrement( failures );
+    return count <= 16 || !(count % 4096);
+}
 
