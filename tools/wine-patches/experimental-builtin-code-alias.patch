--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1830,3 +1830,45 @@
 
     release_object( process );
 }
+
+struct builtin_alias_query
+{
+    struct process *target;
+    client_ptr_t input, output;
+};
+
+static int find_builtin_alias( struct process *process, void *context )
+{
+    struct builtin_alias_query *query = context;
+    struct memory_view *source, *target;
+    struct unicode_str source_name, target_name;
+    if (process == query->target) return 0;
+    LIST_FOR_EACH_ENTRY( source, &process->views, struct memory_view, entry )
+    {
+        if (!(source->flags & SEC_IMAGE) || !source->image.wine_builtin ||
+            query->input < source->base || query->input - source->base >= source->size) continue;
+        if (!get_view_nt_name( source, &source_name )) continue;
+        LIST_FOR_EACH_ENTRY( target, &query->target->views, struct memory_view, entry )
+        {
+            if (!(target->flags & SEC_IMAGE) || !target->image.wine_builtin ||
+                target->size != source->size || target->image.machine != source->image.machine) continue;
+            if (!get_view_nt_name( target, &target_name ) || source_name.len != target_name.len ||
+                memcmp( source_name.str, target_name.str, source_name.len )) continue;
+            query->output = target->base + (query->input - source->base);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+DECL_HANDLER(get_builtin_code_alias)
+{
+    struct builtin_alias_query query = { current->process, req->addr, req->addr };
+    struct memory_view *view;
+    reply->addr = req->addr;
+    /* Existing addresses in this process always retain their identity. */
+    LIST_FOR_EACH_ENTRY( view, &current->process->views, struct memory_view, entry )
+        if (req->addr >= view->base && req->addr - view->base < view->size) return;
+    enum_processes( find_builtin_alias, &query );
+    reply->addr = query.output;
+}
